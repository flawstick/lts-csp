{
  "family": "lts-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::988904099875:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "lts-task",
      "image": "988904099875.dkr.ecr.eu-west-2.amazonaws.com/lts-task:latest",
      "essential": true,
      "environment": [
        {
          "name": "WORKER_MODE",
          "value": "service"
        },
        {
          "name": "BROWSER_STARTUP_TIMEOUT_MS",
          "value": "45000"
        },
        {
          "name": "BROWSER_JOB_POLL_INTERVAL_MS",
          "value": "1500"
        },
        {
          "name": "BROWSER_JOB_HEARTBEAT_INTERVAL_MS",
          "value": "10000"
        },
        {
          "name": "CLOUDWATCH_LOG_GROUP",
          "value": "/ecs/lts-task"
        },
        {
          "name": "WORKER_CONTAINER_NAME",
          "value": "lts-task"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/lts-task",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
