# Database
DATABASE_URL=postgresql://user:password@localhost:5432/lts

# Redis
REDIS_URL=redis://localhost:6379

# AWS ECS Fargate Configuration
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ECS_CLUSTER=
ECS_TASK_DEFINITION=
ECS_CONTAINER_NAME=
ECS_SUBNETS=
ECS_SECURITY_GROUPS=
ECS_LOG_GROUP=/ecs/tax-jobs
TAX_SYNC_EXECUTION_MODE=ecs
TAX_SYNC_HANDLER_URL=
TAX_SYNC_HANDLER_TOKEN=
TAX_SYNC_HANDLER_TIMEOUT_MS=15000
TAX_SYNC_SCHEDULER_ENABLED=false
TAX_SYNC_SCHEDULER_INTERVAL_MS=1800000
TAX_SYNC_SCHEDULER_RUN_ON_BOOT=true
TAX_SYNC_SCHEDULER_JURISDICTIONS=GG,JE
TAX_SYNC_SCHEDULER_ORG_IDS=
TAX_SYNC_SCHEDULER_ORG_SLUGS=
ECS_BROWSER_TASK_SERVICE=lts-browser-workers
ECS_BROWSER_TASK_DESIRED_COUNT=2
BROWSER_TASK_EXECUTION_MODE=ecs_service
BROWSER_STARTUP_TIMEOUT_MS=45000
BROWSER_WORKER_POLL_INTERVAL_MS=1500
BROWSER_WORKER_HEARTBEAT_INTERVAL_MS=10000

# MyGov Portal Authentication (for tax-sync)
MYGOV_USERNAME=
MYGOV_PASSWORD=

# Anthropic (for browser-use AI)
ANTHROPIC_API_KEY=

# Browser Use Cloud API
BROWSER_USE_API_KEY=

# Resend
RESEND_API_KEY=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Job config
HEADLESS=true
JOB_PAYLOAD=
